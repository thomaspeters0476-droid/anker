{
  "name": "anker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview",
    "build:native": "tsc -b && vite build --base /",
    "build:native:schublade": "tsc -b && vite build --base / --mode schublade",
    "android:sync": "npm run build:native && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:schublade:sync": "npm run build:native:schublade && node scripts/cap-with-product.mjs schublade sync android",
    "android:schublade:open": "node scripts/cap-with-product.mjs schublade open android",
    "android:schublade:apk": "npm run android:schublade:sync && cd android-schublade && gradlew.bat assembleDebug",
    "android:twa:update": "cd android-twa && npx --yes @bubblewrap/cli update --skipVersionUpgrade",
    "android:twa:apk": "cd android-twa && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.111.0",
    "dompurify": "^3.4.12",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "marked": "^18.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.54.2",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
