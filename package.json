{
  "name": "anker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview",
    "android:update": "cd android && npx --yes @bubblewrap/cli update --skipVersionUpgrade",
    "android:apk": "cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dompurify": "^3.4.12",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "marked": "^18.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.1",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
