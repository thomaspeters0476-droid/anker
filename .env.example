# Anker — local / Vercel env example (keine Secrets committen)

# Resend (Ablauf-Mail + Sync-Code)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Tagesanker <noreply@tagesanker.de>

# Supabase (Client — Geräte-Sync Session)
VITE_SUPABASE_URL=https://ueioxiffwfsgbmiowtew.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase (Server — Sync-OTP + Stripe-Ledger)
SUPABASE_URL=https://ueioxiffwfsgbmiowtew.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# Stripe (Vorbereitung — Checkout öffentlich aus)
# Details: docs/STRIPE.md
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Abos (brutto): TA 3,49/34,90 · Schublade 4,99/49,90 · Bundle 7,49/74,90
STRIPE_PRICE_MONTHLY=price_xxx_ta_month_349
STRIPE_PRICE_YEARLY=price_xxx_ta_year_3490
STRIPE_PRICE_SCHUBLADE_MONTHLY=price_xxx_schub_month_499
STRIPE_PRICE_SCHUBLADE_YEARLY=price_xxx_schub_year_4990
STRIPE_PRICE_BUNDLE_MONTHLY=price_xxx_bundle_month_749
STRIPE_PRICE_BUNDLE_YEARLY=price_xxx_bundle_year_7490
STRIPE_CHECKOUT_ENABLED=false
# true = Abo-Checkout öffentlich UND Paywall in /app + /schublade aktiv
# KI-Nachkauf S/M/L (0,99 / 2,49 / 4,99) — unabhängig vom Abo-Checkout
STRIPE_PRICE_CHOP_S=price_xxx_chop_s_99
STRIPE_PRICE_CHOP_M=price_xxx_chop_m_249
STRIPE_PRICE_CHOP_L=price_xxx_chop_l_499
STRIPE_CHOP_PACKS_ENABLED=false
STRIPE_CHECKOUT_PREVIEW_TOKEN=
SPEND_POT_REPORT_TOKEN=
PUBLIC_SITE_URL=https://tagesanker.de
# Optional: Anon-Key auch server-seitig für JWT-Verify (sonst VITE_SUPABASE_ANON_KEY)
# SUPABASE_ANON_KEY=

# Azure OpenAI (Schublade: KI-Häppchen) — gleiche Namen wie Schwundbuch
# Nur Server / Vercel, nie VITE_*
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
